# ============================================================
# Outreach Platform — configurazione (copia in .env e completa)
# ============================================================

# --- Database (Neon/Supabase, regione UE) ---
# Nota: aggiungi sempre ?sslmode=require
DATABASE_URL=postgresql+psycopg://UTENTE:PASSWORD@HOST/DBNAME?sslmode=require

# --- Sicurezza applicativa ---
SECRET_KEY=cambia-questa-chiave-lunga-e-casuale
ADMIN_PASSWORD=cambia-questa-password
ADMIN_USER=luca@schoenbech.com

# --- Mittente / canali di invio ---
SENDER_EMAIL=luca@schoenbech.com
SENDER_NAME=Schoenbech • Talent Advisory
REPLY_TO=luca@schoenbech.com

# Gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Aruba
ARUBA_SMTP_SERVER=smtps.aruba.it
ARUBA_SMTP_PORT=465
ARUBA_IMAP_SERVER=imaps.aruba.it
ARUBA_IMAP_PORT=993
ARUBA_EMAIL=luca@schoenbech.com
ARUBA_PASSWORD=

# --- Ritmo invio (secondi) ---
DELAY_MIN=65
DELAY_MAX=115
BREAK_MIN=150
BREAK_MAX=240
PAUSE_EVERY=10

# --- AI (DeepSeek principale, Gemini fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_MODEL_FALLBACKS=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-flash-lite-latest,gemini-2.5-flash
GEMINI_THINKING=medium

# --- Link esempio mappatura (usato nell'email; se manca, l'invio è bloccato) ---
LINK_MAPPATURA=https://businessintelligence.schoenbech.com/accesso/1u3i1QKs5T7ivJph_uAHbqBMIkuoCa-m

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8788
